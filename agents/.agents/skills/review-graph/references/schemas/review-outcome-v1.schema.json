{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-graph-review-outcome-v1",
  "$defs": {
    "rejection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted",
            "recovery"
          ],
          "properties": {
            "kind": {
              "const": "missing-required-input"
            },
            "accepted": {
              "const": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "automatic_retry"
              ],
              "properties": {
                "kind": {
                  "const": "supply-required-input"
                },
                "scope": {
                  "const": "affected-evaluation"
                },
                "automatic_retry": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted",
            "recovery"
          ],
          "properties": {
            "kind": {
              "const": "malformed-input"
            },
            "accepted": {
              "const": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "automatic_retry"
              ],
              "properties": {
                "kind": {
                  "const": "correct-input"
                },
                "scope": {
                  "const": "affected-evaluation"
                },
                "automatic_retry": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted",
            "recovery"
          ],
          "properties": {
            "kind": {
              "const": "missing-evidence"
            },
            "accepted": {
              "const": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "automatic_retry"
              ],
              "properties": {
                "kind": {
                  "const": "obtain-evidence"
                },
                "scope": {
                  "const": "affected-evaluation"
                },
                "automatic_retry": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted",
            "recovery"
          ],
          "properties": {
            "kind": {
              "const": "stale-capture"
            },
            "accepted": {
              "const": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "automatic_retry"
              ],
              "properties": {
                "kind": {
                  "const": "recapture-source"
                },
                "scope": {
                  "const": "affected-evaluation"
                },
                "automatic_retry": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted",
            "recovery"
          ],
          "properties": {
            "kind": {
              "const": "unsupported-transition"
            },
            "accepted": {
              "const": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "automatic_retry"
              ],
              "properties": {
                "kind": {
                  "const": "reconcile-transition"
                },
                "scope": {
                  "const": "affected-evaluation"
                },
                "automatic_retry": {
                  "const": false
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted",
            "recovery"
          ],
          "properties": {
            "kind": {
              "const": "unclassified-failure"
            },
            "accepted": {
              "const": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "automatic_retry"
              ],
              "properties": {
                "kind": {
                  "const": "inspect-blocker"
                },
                "scope": {
                  "const": "affected-evaluation"
                },
                "automatic_retry": {
                  "const": false
                }
              }
            }
          }
        }
      ]
    },
    "next-ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "command"
      ],
      "properties": {
        "kind": {
          "const": "continue-review"
        },
        "operation": {
          "const": "next-ready"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
