{
  "$id": "https://openai.com/codex/review-graph/validation-payload-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
          "artifact_id": {"type": ["string", "null"]},
          "kind": {"enum": ["build", "cache", "coverage", "log", "report", "test-result", "other"]},
          "path": {"type": "string"},
          "repository_status": {"enum": ["ignored", "outside-repository"]}
        },
        "required": ["path", "kind", "repository_status", "artifact_digest"],
        "type": "object"
      },
      "type": "array"
    },
    "executions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_paths": {"items": {"type": "string"}, "type": "array"},
          "command": {"type": "string"},
          "elapsed": {"type": ["string", "number", "null"]},
          "evidence": {"type": "string"},
          "executor": {"type": "string"},
          "exit_code": {"type": ["integer", "string", "null"]},
          "result": {"enum": ["passed", "failed", "blocked", "not-run"]},
          "working_directory": {"type": "string"}
        },
        "required": ["executor", "command", "working_directory", "result", "evidence", "artifact_paths"],
        "type": "object"
      },
      "type": "array"
    },
    "limitations": {"items": {"type": "string"}, "type": "array"},
    "status": {"enum": ["passed", "failed", "blocked", "reused", "not-applicable"]}
  },
  "required": ["status", "executions", "artifacts", "limitations"],
  "title": "Review Graph ValidationPayload v1",
  "type": "object"
}
