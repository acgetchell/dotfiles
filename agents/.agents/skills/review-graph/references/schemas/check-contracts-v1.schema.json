{
  "$id": "https://openai.com/codex/review-graph/check-contracts-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Validation Check Contracts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "commands",
          "working_directories",
          "implementation_paths",
          "input_scope",
          "input_prefixes",
          "git_inputs",
          "deterministic",
          "rationale"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "working_directories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input_scope": {
            "enum": [
              "repository",
              "prefixes"
            ]
          },
          "input_prefixes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "git_inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "index",
                "head",
                "history",
                "comparison"
              ]
            }
          },
          "deterministic": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
